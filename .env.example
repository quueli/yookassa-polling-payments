BOT_TOKEN=123456789:YOUR_TOKEN
# group where paid orders are posted; supergroup ids start with -100
ADMIN_CHAT_ID=-1001234567890

DATABASE_URL=sqlite:///data/orders.db

# test credentials from the yookassa dashboard work fine here
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_YOUR_SECRET_KEY

# polling: ask yookassa every POLLING_INTERVAL seconds, give up after MAX_POLLING_ATTEMPTS checks
USE_PAYMENT_POLLING=true
POLLING_INTERVAL=30
MAX_POLLING_ATTEMPTS=120

# receipt data yookassa wants when the shop has fiscalization enabled
RECEIPT_EMAIL=receipts@example.com
RECEIPT_VAT_CODE=1

# only for webhook_server.py
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
